---
import Workspace from '../workspace/Workspace';
import '../workspace/workspace.css';
import '../workspace/workspace-refined.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Ephemeral — a shared workspace for healthcare data and confidential AI research."/>
  <title>Ephemeral · Research workspace</title>
  <link rel="icon" type="image/png" href="/assets/brand/ephemeral-mark.png"/>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/satoshi-400.woff2" crossorigin/>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/satoshi-500.woff2" crossorigin/>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/satoshi-700.woff2" crossorigin/>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #f7f4ee;
      color: #161616;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      min-height: 100vh;
    }
    .app-initial-loader {
      position: fixed;
      inset: 0;
      background: #f7f4ee;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 99999;
      transition: opacity 0.35s ease, visibility 0.35s ease;
    }
    .app-initial-loader.fade-out {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .loader-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 36px 40px;
      max-width: 380px;
      width: 90%;
    }
    .loader-avatar {
      position: relative;
      width: 80px;
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 22px;
    }
    .loader-ring {
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      border: 2px solid rgba(185, 139, 110, 0.25);
      border-top-color: #b98b6e;
      animation: loaderSpin 1.1s cubic-bezier(0.55, 0.15, 0.45, 0.85) infinite;
    }
    .loader-avatar img {
      width: 52px;
      height: 52px;
      object-fit: contain;
      border-radius: 12px;
      animation: loaderPulse 2s ease-in-out infinite;
    }
    .loader-brand {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.8px;
      color: #161616;
      margin-bottom: 6px;
    }
    .loader-brand span {
      color: #b98b6e;
      font-weight: 500;
    }
    .loader-text {
      font-size: 13px;
      color: #787069;
      margin: 0 0 20px 0;
      line-height: 1.5;
    }
    .loader-progress {
      width: 180px;
      height: 3px;
      background: rgba(185, 139, 110, 0.18);
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 22px;
    }
    .loader-progress-inner {
      height: 100%;
      width: 45%;
      background: linear-gradient(90deg, #b98b6e, #6e4e37);
      border-radius: 10px;
      animation: loaderBar 1.4s ease-in-out infinite;
    }
    .loader-pills {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 11px;
      color: #9d9389;
      letter-spacing: 0.3px;
    }
    @keyframes loaderSpin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    @keyframes loaderPulse {
      0%, 100% { transform: scale(1); opacity: 0.95; }
      50% { transform: scale(1.06); opacity: 1; }
    }
    @keyframes loaderBar {
      0% { transform: translateX(-100%); }
      50% { transform: translateX(120%); }
      100% { transform: translateX(260%); }
    }
  </style>
</head>
<body>
  <!-- Immediate inline splash loader rendered before JS bundles hydrate -->
  <div id="initial-app-loader" class="app-initial-loader">
    <div class="loader-box">
      <div class="loader-avatar">
        <div class="loader-ring"></div>
        <img src="/assets/brand/ephemeral-mark.png" alt="Ephemeral" width="52" height="52"/>
      </div>
      <div class="loader-brand">Ephemeral <span>Workspace</span></div>
      <p class="loader-text">Loading research workspace…</p>
      <div class="loader-progress">
        <div class="loader-progress-inner"></div>
      </div>
      <div class="loader-pills">
        <span>Base Mainnet</span>
        <span>·</span>
        <span>Swarm ACT</span>
        <span>·</span>
        <span>Arkiv Data</span>
      </div>
    </div>
  </div>

  <Workspace client:only="react" />
</body>
</html>
